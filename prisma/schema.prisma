generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ── Model milik /fire ────────────────────────────────────────────────────────
// Skema dipertahankan agar cocok dengan kolom yang ditulis Laravel (skema asli
// tetap milik Laravel; di sini kolom lain yang tidak dipakai CMS ini TIDAK
// dibuatkan model). Tabel users ikut dipertahankan karena akun Pasopati dipakai
// untuk masuk CMS.

model users {
  id                  BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name                String              @db.VarChar(255)
  email               String              @unique(map: "users_email_unique") @db.VarChar(255)
  google_id           String?             @unique(map: "users_google_id_unique") @db.VarChar(255)
  /// `sub` Sign in with Apple dari aplikasi mobile (iOS).
  apple_id            String?             @unique(map: "users_apple_id_unique") @db.VarChar(255)
  /// refresh_token Sign in with Apple, hanya untuk dicabut (auth/revoke) saat
  /// akun dihapus — syarat App Store 5.1.1(v). Tak berguna tanpa kunci .p8.
  /// Disimpan tersegel AES-256-GCM (segelTokenApple, APPLE_TOKEN_SECRET).
  apple_refresh_token String?             @db.Text
  /// Bundle ID (client_id) penerbit token itu: produksi atau varian .preview.
  apple_client_id     String?             @db.VarChar(255)
  /// Bawaan commenter: baris yang disisipkan aplikasi Laravel tanpa peran
  /// (mis. akun Google) tidak boleh otomatis menjadi editor CMS.
  role                users_role          @default(commenter)
  email_verified_at   DateTime?           @db.Timestamp(0)
  password            String?             @db.VarChar(255)
  image               String?             @db.VarChar(255)
  /// Warisan basis data bersama (aplikasi Laravel) — tidak dipakai Next.js,
  /// tapi tetap dideklarasikan supaya schema = migrasi = DB (cek drift di CI).
  remember_token      String?             @db.VarChar(100)
  created_at          DateTime?           @db.Timestamp(0)
  updated_at          DateTime?           @db.Timestamp(0)
  /// Verifikasi KTP disetujui (syarat siaran langsung publik dari aplikasi).
  /// null = belum. Lihat lib/verifikasi-ktp.ts.
  ktp_verified_at     DateTime?           @db.Timestamp(0)
  /// HMAC-SHA256 NIK yang disetujui (KTP_NIK_SECRET), bukan NIK-nya. Unik:
  /// satu NIK hanya untuk satu akun terverifikasi.
  ktp_nik_hash        String?             @unique(map: "users_ktp_nik_hash_unique") @db.Char(64)
  comment_reactions   comment_reactions[]
  comments            comments[]
  public_reports      public_reports[]    @relation("peninjau")
  /// Laporan yang dikirim akun ini dari aplikasi mobile (bukan yang anonim).
  laporan_warga       public_reports[]    @relation("pelapor")
  passkeys            passkeys[]
  mobile_sessions     mobile_sessions[]
  content_reports     content_reports[]
  /// Pengajuan verifikasi KTP akun ini dari aplikasi mobile.
  verifikasi_ktp      mobile_ktp_verifications[] @relation("pemohon_ktp")
  /// Pengajuan KTP yang diputuskan akun CMS ini.
  tinjauan_ktp        mobile_ktp_verifications[] @relation("peninjau_ktp")
}

model events {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  image_id         String?            @db.VarChar(300)
  video            String?            @db.VarChar(300)
  /// Warisan basis data bersama (aplikasi Laravel) — tidak dipakai Next.js,
  /// tapi tetap dideklarasikan supaya schema = migrasi = DB (cek drift di CI).
  image_en         String?            @db.VarChar(300)
  location_geojson Json?
  /// Galeri media tambahan: [{ path, type: "image" | "video" }]
  media            Json?
  title_id         String             @db.VarChar(255)
  slug             String?            @unique(map: "events_slug_unique") @db.VarChar(255)
  title_en         String             @db.VarChar(255)
  /// Warisan basis data bersama (aplikasi Laravel) — tidak dipakai Next.js (isinya
  /// di description_id/_en), tapi tetap dideklarasikan supaya schema = migrasi = DB.
  desc_id          String?            @db.Text
  desc_en          String?            @db.Text
  description_id   String?            @db.Text
  description_en   String?            @db.Text
  event_date       DateTime           @db.Date
  location         String             @db.VarChar(255)
  location_lat     Decimal            @db.Decimal(10, 7)
  location_lng     Decimal            @db.Decimal(10, 7)
  orientation      events_orientation @default(landscape)
  /// draft = tersimpan di CMS tapi belum tampil di situs publik.
  /// Bawaannya published supaya kejadian yang sudah ada tidak menghilang
  /// begitu kolom ini ditambahkan.
  status           events_status      @default(published)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  event_likes      event_likes[]
  public_reports   public_reports[]

  @@index([event_date], map: "events_event_date_index")
  @@index([status, event_date(sort: Desc)], map: "events_status_event_date_index")
  @@index([status], map: "events_status_index")
  @@index([orientation], map: "events_orientation_index")
}

model comments {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  commentable_type  String?             @db.VarChar(190)
  commentable_id    BigInt?             @db.UnsignedBigInt
  user_id           BigInt?             @db.UnsignedBigInt
  name              String?             @db.VarChar(255)
  email             String?             @db.VarChar(255)
  body              String              @db.Text
  ip_address        String?             @db.VarChar(45)
  is_approved       Boolean             @default(true)
  parent_id         BigInt?             @db.UnsignedBigInt
  mention_name      String?             @db.VarChar(255)
  /// Warisan basis data bersama (aplikasi Laravel) — tidak dipakai Next.js,
  /// tapi tetap dideklarasikan supaya schema = migrasi = DB (cek drift di CI).
  page_id           BigInt?             @db.UnsignedBigInt
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  comment_reactions comment_reactions[]
  comments          comments?           @relation("commentsTocomments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comments_parent_id_foreign")
  other_comments    comments[]          @relation("commentsTocomments")
  users             users?              @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "comments_user_id_foreign")

  @@index([commentable_type, commentable_id, is_approved], map: "comments_commentable_index")
  @@index([is_approved, created_at], map: "comments_is_approved_created_at_index")
  // Warisan basis data bersama (indeks buatan aplikasi Laravel).
  @@index([page_id, is_approved], map: "comments_page_id_is_approved_index")
  @@index([parent_id], map: "comments_parent_id_foreign")
  @@index([user_id], map: "comments_user_id_foreign")
}

model comment_reactions {
  id         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  comment_id BigInt                 @db.UnsignedBigInt
  user_id    BigInt?                @db.UnsignedBigInt
  ip_address String?                @db.VarChar(45)
  type       comment_reactions_type
  created_at DateTime?              @db.Timestamp(0)
  updated_at DateTime?              @db.Timestamp(0)
  comments   comments               @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comment_reactions_comment_id_foreign")
  users      users?                 @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "comment_reactions_user_id_foreign")

  @@unique([comment_id, user_id], map: "comment_reactions_comment_id_user_id_unique")
  @@index([comment_id, ip_address], map: "comment_reactions_comment_id_ip_address_index")
  @@index([user_id], map: "comment_reactions_user_id_foreign")
}

/// Suka (jempol) pengunjung pada kejadian — satu per perangkat
/// (visitor_hash = sha256(ip|user agent)) per kejadian. Tabel milik CMS ini.
model event_likes {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  event_id     BigInt    @db.UnsignedBigInt
  visitor_hash String    @db.Char(64)
  ip_address   String?   @db.VarChar(45)
  user_agent   String?   @db.VarChar(512)
  created_at   DateTime? @db.Timestamp(0)
  events       events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "event_likes_event_id_foreign")

  @@unique([event_id, visitor_hash], map: "event_likes_event_id_visitor_hash_unique")
  @@index([created_at], map: "event_likes_created_at_index")
}

enum users_role {
  admin
  editor
  commenter
}

enum comment_reactions_type {
  like
  dislike
}

enum events_orientation {
  landscape
  horizontal
}

enum events_status {
  draft
  published
}

// ── Laporan warga ────────────────────────────────────────────────────────────
// Tabel MILIK CMS ini, bukan warisan Laravel — tapi namanya tetap Inggris dan
// snake_case seperti tetangganya, karena ia duduk di basis data yang sama dan
// dibaca orang yang sama.
//
// Terpisah dari `events` dengan sengaja: kiriman orang luar belum tentu benar,
// sedangkan apa pun yang masuk `events` langsung tampil di korsel dan ikut
// terhitung di peta. Yang lolos verifikasi disalin ke sana oleh editor, bukan
// mengalir sendiri.

model public_reports {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  title          String                @db.VarChar(255)
  /// Judul & deskripsi Inggris, plus nama tempat — semuanya dirapikan kurator
  /// sebelum verifikasi, bukan dikirim pelapor. Kosong = promosi memakai
  /// perilaku lama (judul ID disalin, deskripsi EN null, lokasi di-geocode).
  title_en       String?               @db.VarChar(255)
  description    String                @db.Text
  description_en String?               @db.Text
  /// Nama tempat pilihan kurator. Kosong = promosi me-reverse-geocode sendiri
  /// dari koordinat, seperti sebelumnya.
  location       String?               @db.VarChar(255)
  /// Lampiran: [{ path, type: "image" | "video" }] — bentuknya sama persis
  /// dengan events.media, jadi bacaBerkasMedia() dipakai bersama.
  media          Json?
  /// null = pelapor memilih anonim. Kolomnya kosong, bukan diisi "Anonim":
  /// nama "Anonim" tidak bisa dibedakan dari orang yang memang mengetik itu.
  reporter_name  String?               @db.VarChar(255)
  /// Keduanya opsional dan selalu berpasangan — lihat simpanLaporanPublik().
  location_lat   Decimal?              @db.Decimal(10, 7)
  location_lng   Decimal?              @db.Decimal(10, 7)
  status         public_reports_status @default(pending)
  /// Keadaan tayang yang dituju kejadian hasil promosi — bukan status laporan.
  event_status   events_status         @default(published)
  ip_address     String?               @db.VarChar(45)
  reviewed_by    BigInt?               @db.UnsignedBigInt
  reviewed_at    DateTime?             @db.Timestamp(0)
  created_at     DateTime?             @db.Timestamp(0)
  updated_at     DateTime?             @db.Timestamp(0)
  /// Akun pengirim dari aplikasi mobile. Diisi HANYA bila kiriman membawa
  /// token sesi dan tidak anonim — laporan anonim tidak pernah terikat ke akun.
  reporter_user_id BigInt?             @db.UnsignedBigInt
  /// Kejadian hasil promosi saat laporan diverifikasi, supaya pelapor bisa
  /// membukanya dari "Laporanku" di aplikasi.
  event_id       BigInt?               @db.UnsignedBigInt
  peninjau       users?                @relation("peninjau", fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "public_reports_reviewed_by_foreign")
  pelapor        users?                @relation("pelapor", fields: [reporter_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "public_reports_reporter_user_id_foreign")
  kejadian       events?               @relation(fields: [event_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "public_reports_event_id_foreign")

  @@index([status, created_at], map: "public_reports_status_created_at_index")
  @@index([reviewed_by], map: "public_reports_reviewed_by_foreign")
  @@index([reporter_user_id, created_at], map: "public_reports_reporter_user_id_created_at_index")
  @@index([event_id], map: "public_reports_event_id_foreign")
}

enum public_reports_status {
  pending
  approved
  rejected
}

// ── Sorotan angka landing karhutla ─────────────────────────────────────────
// Kartu strip statistik landing (angka + keterangan, per bahasa). Satu baris
// hidup (id terkecil yang ada); belum ada baris = bawaan lib/statistik.ts.
// Diisi lewat CMS (/admin/statistik) — angkanya dari sumber luar
// (MapBiomas/CELIOS/KEMENKES/dll) yang disalin kurator.
model sorotan_statistik {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// { id: [{ nilai, keterangan }], en: [{ nilai, keterangan }] }
  kartu      Json?
  updated_at DateTime? @db.Timestamp(0)
}

/// Passkey (WebAuthn) untuk masuk CMS dengan sidik jari / wajah. Biometriknya
/// tidak pernah sampai ke server — perangkat memverifikasi, lalu menandatangani
/// tantangan dengan kunci privat yang tak keluar dari perangkat. Yang disimpan
/// cuma kunci publiknya. Tabel milik CMS ini.
model passkeys {
  /// ID kredensial (base64url) dari authenticator.
  id           String    @id @db.VarChar(255)
  user_id      BigInt    @db.UnsignedBigInt
  public_key   Bytes     @db.Blob
  counter      BigInt    @default(0) @db.UnsignedBigInt
  transports   String?   @db.VarChar(255)
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  last_used_at DateTime? @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "passkeys_user_id_foreign")

  @@index([user_id], map: "passkeys_user_id_foreign")
}

/// Perangkat penerima notifikasi push aplikasi mobile (Expo Push, lib/notifikasi-push.ts): setiap
/// pemasang aplikasi, dengan atau tanpa akun. Hanya token Expo & pilihan jenisnya yang disimpan —
/// tidak terhubung ke akun. Token yang ditolak Expo (DeviceNotRegistered) dibuang saat mengirim.
model mobile_push_tokens {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  token      String   @unique(map: "mobile_push_tokens_token_unique") @db.VarChar(255)
  /// "ios" | "android"
  platform   String   @db.VarChar(16)
  /// Mau dikabari siaran langsung publik yang baru mulai.
  live       Boolean  @default(true)
  /// Mau dikabari laporan yang baru ditayangkan petugas.
  laporan    Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
}

/// Sesi aplikasi mobile (akun warga). Terpisah dari cookie sesi CMS: token
/// acak dikirim sebagai Bearer, yang disimpan hanya sha256-nya, dan barisnya
/// dihapus saat keluar. Tabel milik CMS ini.
model mobile_sessions {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  token_hash   String    @unique(map: "mobile_sessions_token_hash_unique") @db.Char(64)
  user_id      BigInt    @db.UnsignedBigInt
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  last_used_at DateTime? @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mobile_sessions_user_id_foreign")

  @@index([user_id], map: "mobile_sessions_user_id_foreign")
}

/// Laporan konten dari aplikasi mobile ("Laporkan"): komentar, laporan warga di
/// umpan, atau siaran langsung. Syarat App Store/Play untuk konten buatan
/// pengguna. Komentar yang dilaporkan beberapa orang disembunyikan otomatis
/// (is_approved = false) sambil menunggu moderator. Tabel milik CMS ini.
model content_reports {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// komentar | laporan | siaran
  jenis            String    @db.VarChar(20)
  /// id komentar / id kejadian / nama ruang siaran
  target_id        String    @db.VarChar(100)
  alasan           String    @db.VarChar(30)
  catatan          String?   @db.Text
  reporter_user_id BigInt?   @db.UnsignedBigInt
  ip_address       String?   @db.VarChar(45)
  /// baru | ditinjau
  status           String    @default("baru") @db.VarChar(20)
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  users            users?    @relation(fields: [reporter_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "content_reports_reporter_user_id_foreign")

  @@index([jenis, target_id], map: "content_reports_jenis_target_id_index")
  @@index([status, created_at], map: "content_reports_status_created_at_index")
  @@index([reporter_user_id], map: "content_reports_reporter_user_id_foreign")
}

/// Verifikasi KTP akun warga — syarat siaran langsung publik dari aplikasi
/// mobile. Petugas CMS (/admin/verifikasi) mencocokkan foto KTP dengan NIK
/// ketikan; penyedia eKYC (lib/ekyc.ts) boleh menyetujui lebih dulu bila
/// dipasang. Tabel milik CMS ini.
///
/// Data seminimal mungkin: foto (di KTP_DIR, tak pernah dilayani publik) dan
/// NIK polos hanya ada selama `menunggu`, lalu dibuang begitu diputuskan.
/// Setelah itu yang tersisa status, waktu, metode, peninjau, alasan tolak, dan
/// HMAC NIK. Pengajuan `menunggu` lebih dari 30 hari dihapus saat antrean atau
/// status dibaca (sapuKedaluwarsa di lib/verifikasi-ktp.ts).
model mobile_ktp_verifications {
  id          BigInt                               @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt                               @db.UnsignedBigInt
  status      mobile_ktp_verifications_status      @default(menunggu)
  /// NIK ketikan warga, dicocokkan peninjau dengan foto. null setelah diputuskan.
  nik         String?                              @db.VarChar(16)
  /// HMAC-SHA256 NIK (KTP_NIK_SECRET) — disalin ke users.ktp_nik_hash saat disetujui.
  nik_hash    String                               @db.Char(64)
  /// Nama berkas foto KTP (acak) di KTP_DIR. null setelah diputuskan (berkasnya dihapus).
  ktp_path    String?                              @db.VarChar(64)
  /// OCR foto KTP (EKYC_PROVIDER=paddleocr, lib/ocr-ktp.ts): NIK di foto
  /// dibandingkan NIK ketikan. null = OCR tidak dijalankan.
  ocr_result  mobile_ktp_verifications_ocr_result?
  /// NIK yang terbaca OCR. null setelah diputuskan, seperti `nik`.
  ocr_nik     String?                              @db.VarChar(16)
  /// Skor baca terendah baris NIK itu (0–1).
  ocr_score   Float?
  method      mobile_ktp_verifications_method?
  /// Alasan penolakan — ditampilkan ke warga di aplikasi.
  reason      String?                              @db.Text
  reviewer_id BigInt?                              @db.UnsignedBigInt
  created_at  DateTime                             @default(now()) @db.Timestamp(0)
  decided_at  DateTime?                            @db.Timestamp(0)
  pemohon     users                                @relation("pemohon_ktp", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mobile_ktp_verifications_user_id_foreign")
  peninjau    users?                               @relation("peninjau_ktp", fields: [reviewer_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "mobile_ktp_verifications_reviewer_id_foreign")

  @@index([user_id, created_at], map: "mobile_ktp_verifications_user_id_created_at_index")
  @@index([status, created_at], map: "mobile_ktp_verifications_status_created_at_index")
  @@index([reviewer_id], map: "mobile_ktp_verifications_reviewer_id_foreign")
}

enum mobile_ktp_verifications_status {
  menunggu
  disetujui
  ditolak
}

enum mobile_ktp_verifications_method {
  petugas
  ekyc
}

enum mobile_ktp_verifications_ocr_result {
  cocok
  beda
  tak_terbaca
  gagal
}
