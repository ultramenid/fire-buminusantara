generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ── Model milik /fire ────────────────────────────────────────────────────────
// Skema dipertahankan agar cocok dengan kolom yang ditulis Laravel (skema asli
// tetap milik Laravel; di sini kolom lain yang tidak dipakai CMS ini TIDAK
// dibuatkan model). Tabel users ikut dipertahankan karena akun Pasopati dipakai
// untuk masuk CMS.

model users {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name              String              @db.VarChar(255)
  email             String              @unique(map: "users_email_unique") @db.VarChar(255)
  google_id         String?             @unique(map: "users_google_id_unique") @db.VarChar(255)
  role              users_role          @default(editor)
  email_verified_at DateTime?           @db.Timestamp(0)
  password          String?             @db.VarChar(255)
  image             String?             @db.VarChar(255)
  /// Warisan basis data bersama (aplikasi Laravel) — tidak dipakai Next.js,
  /// tapi tetap dideklarasikan supaya schema = migrasi = DB (cek drift di CI).
  remember_token    String?             @db.VarChar(100)
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  comment_reactions comment_reactions[]
  comments          comments[]
  public_reports    public_reports[]
  passkeys          passkeys[]
}

model events {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  image_id         String?            @db.VarChar(300)
  video            String?            @db.VarChar(300)
  /// Warisan basis data bersama (aplikasi Laravel) — tidak dipakai Next.js,
  /// tapi tetap dideklarasikan supaya schema = migrasi = DB (cek drift di CI).
  image_en         String?            @db.VarChar(300)
  location_geojson Json?
  /// Galeri media tambahan: [{ path, type: "image" | "video" }]
  media            Json?
  title_id         String             @db.VarChar(255)
  slug             String?            @unique(map: "events_slug_unique") @db.VarChar(255)
  title_en         String             @db.VarChar(255)
  description_id   String?            @db.Text
  description_en   String?            @db.Text
  event_date       DateTime           @db.Date
  location         String             @db.VarChar(255)
  location_lat     Decimal            @db.Decimal(10, 7)
  location_lng     Decimal            @db.Decimal(10, 7)
  orientation      events_orientation @default(landscape)
  /// draft = tersimpan di CMS tapi belum tampil di situs publik.
  /// Bawaannya published supaya kejadian yang sudah ada tidak menghilang
  /// begitu kolom ini ditambahkan.
  status           events_status      @default(published)
  created_at       DateTime?          @db.Timestamp(0)
  updated_at       DateTime?          @db.Timestamp(0)
  event_likes      event_likes[]

  @@index([event_date], map: "events_event_date_index")
  @@index([status, event_date(sort: Desc)], map: "events_status_event_date_index")
  @@index([status], map: "events_status_index")
  @@index([orientation], map: "events_orientation_index")
}

model comments {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  commentable_type  String?             @db.VarChar(190)
  commentable_id    BigInt?             @db.UnsignedBigInt
  user_id           BigInt?             @db.UnsignedBigInt
  name              String?             @db.VarChar(255)
  email             String?             @db.VarChar(255)
  body              String              @db.Text
  ip_address        String?             @db.VarChar(45)
  is_approved       Boolean             @default(true)
  parent_id         BigInt?             @db.UnsignedBigInt
  mention_name      String?             @db.VarChar(255)
  /// Warisan basis data bersama (aplikasi Laravel) — tidak dipakai Next.js,
  /// tapi tetap dideklarasikan supaya schema = migrasi = DB (cek drift di CI).
  page_id           BigInt?             @db.UnsignedBigInt
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  comment_reactions comment_reactions[]
  comments          comments?           @relation("commentsTocomments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comments_parent_id_foreign")
  other_comments    comments[]          @relation("commentsTocomments")
  users             users?              @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "comments_user_id_foreign")

  @@index([commentable_type, commentable_id, is_approved], map: "comments_commentable_index")
  @@index([is_approved, created_at], map: "comments_is_approved_created_at_index")
  @@index([parent_id], map: "comments_parent_id_foreign")
  @@index([user_id], map: "comments_user_id_foreign")
}

model comment_reactions {
  id         BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  comment_id BigInt                 @db.UnsignedBigInt
  user_id    BigInt?                @db.UnsignedBigInt
  ip_address String?                @db.VarChar(45)
  type       comment_reactions_type
  created_at DateTime?              @db.Timestamp(0)
  updated_at DateTime?              @db.Timestamp(0)
  comments   comments               @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comment_reactions_comment_id_foreign")
  users      users?                 @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "comment_reactions_user_id_foreign")

  @@unique([comment_id, user_id], map: "comment_reactions_comment_id_user_id_unique")
  @@index([comment_id, ip_address], map: "comment_reactions_comment_id_ip_address_index")
  @@index([user_id], map: "comment_reactions_user_id_foreign")
}

/// Suka (jempol) pengunjung pada kejadian — satu per perangkat
/// (visitor_hash = sha256(ip|user agent)) per kejadian. Tabel milik CMS ini.
model event_likes {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  event_id     BigInt    @db.UnsignedBigInt
  visitor_hash String    @db.Char(64)
  ip_address   String?   @db.VarChar(45)
  user_agent   String?   @db.VarChar(512)
  created_at   DateTime? @db.Timestamp(0)
  events       events    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "event_likes_event_id_foreign")

  @@unique([event_id, visitor_hash], map: "event_likes_event_id_visitor_hash_unique")
  @@index([created_at], map: "event_likes_created_at_index")
}

enum users_role {
  admin
  editor
  commenter
}

enum comment_reactions_type {
  like
  dislike
}

enum events_orientation {
  landscape
  horizontal
}

enum events_status {
  draft
  published
}

// ── Laporan warga ────────────────────────────────────────────────────────────
// Tabel MILIK CMS ini, bukan warisan Laravel — tapi namanya tetap Inggris dan
// snake_case seperti tetangganya, karena ia duduk di basis data yang sama dan
// dibaca orang yang sama.
//
// Terpisah dari `events` dengan sengaja: kiriman orang luar belum tentu benar,
// sedangkan apa pun yang masuk `events` langsung tampil di korsel dan ikut
// terhitung di peta. Yang lolos verifikasi disalin ke sana oleh editor, bukan
// mengalir sendiri.

model public_reports {
  id             BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  title          String                @db.VarChar(255)
  /// Judul & deskripsi Inggris, plus nama tempat — semuanya dirapikan kurator
  /// sebelum verifikasi, bukan dikirim pelapor. Kosong = promosi memakai
  /// perilaku lama (judul ID disalin, deskripsi EN null, lokasi di-geocode).
  title_en       String?               @db.VarChar(255)
  description    String                @db.Text
  description_en String?               @db.Text
  /// Nama tempat pilihan kurator. Kosong = promosi me-reverse-geocode sendiri
  /// dari koordinat, seperti sebelumnya.
  location       String?               @db.VarChar(255)
  /// Lampiran: [{ path, type: "image" | "video" }] — bentuknya sama persis
  /// dengan events.media, jadi bacaBerkasMedia() dipakai bersama.
  media          Json?
  /// null = pelapor memilih anonim. Kolomnya kosong, bukan diisi "Anonim":
  /// nama "Anonim" tidak bisa dibedakan dari orang yang memang mengetik itu.
  reporter_name  String?               @db.VarChar(255)
  /// Keduanya opsional dan selalu berpasangan — lihat simpanLaporanPublik().
  location_lat   Decimal?              @db.Decimal(10, 7)
  location_lng   Decimal?              @db.Decimal(10, 7)
  status         public_reports_status @default(pending)
  /// Keadaan tayang yang dituju kejadian hasil promosi — bukan status laporan.
  event_status   events_status         @default(published)
  ip_address     String?               @db.VarChar(45)
  reviewed_by    BigInt?               @db.UnsignedBigInt
  reviewed_at    DateTime?             @db.Timestamp(0)
  created_at     DateTime?             @db.Timestamp(0)
  updated_at     DateTime?             @db.Timestamp(0)
  peninjau       users?                @relation(fields: [reviewed_by], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "public_reports_reviewed_by_foreign")

  @@index([status, created_at], map: "public_reports_status_created_at_index")
  @@index([reviewed_by], map: "public_reports_reviewed_by_foreign")
}

enum public_reports_status {
  pending
  approved
  rejected
}

// ── Sorotan angka landing karhutla ─────────────────────────────────────────
// Kartu strip statistik landing (angka + keterangan, per bahasa). Satu baris
// hidup (id terkecil yang ada); belum ada baris = bawaan lib/statistik.ts.
// Diisi lewat CMS (/admin/statistik) — angkanya dari sumber luar
// (MapBiomas/CELIOS/KEMENKES/dll) yang disalin kurator.
model sorotan_statistik {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// { id: [{ nilai, keterangan }], en: [{ nilai, keterangan }] }
  kartu      Json?
  updated_at DateTime? @db.Timestamp(0)
}

/// Passkey (WebAuthn) untuk masuk CMS dengan sidik jari / wajah. Biometriknya
/// tidak pernah sampai ke server — perangkat memverifikasi, lalu menandatangani
/// tantangan dengan kunci privat yang tak keluar dari perangkat. Yang disimpan
/// cuma kunci publiknya. Tabel milik CMS ini.
model passkeys {
  /// ID kredensial (base64url) dari authenticator.
  id           String    @id @db.VarChar(255)
  user_id      BigInt    @db.UnsignedBigInt
  public_key   Bytes     @db.Blob
  counter      BigInt    @default(0) @db.UnsignedBigInt
  transports   String?   @db.VarChar(255)
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  last_used_at DateTime? @db.Timestamp(0)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "passkeys_user_id_foreign")

  @@index([user_id], map: "passkeys_user_id_foreign")
}
