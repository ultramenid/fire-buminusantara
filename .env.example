# Database utama (MariaDB via adapter @prisma/adapter-mariadb)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/pasopati

# Kunci penandatanganan cookie sesi CMS (wajib; string acak, mis. `openssl rand -base64 32`)
SESSION_SECRET=

# MinIO untuk berkas media (route /media mengambil objek dengan kredensial server)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fire

# Base URL media lama dari CMS Laravel (path yang tidak berawalan "fire/")
NEXT_PUBLIC_MEDIA_URL=

# Akar absolut situs untuk metadata OG (og:image/og:url pratinjau WhatsApp dsb.)
NEXT_PUBLIC_SITE_URL=https://laporin.app

# Asal situs untuk passkey (masuk sidik jari / wajah). Passkey terikat pada
# domain ini. Kosong = asal NEXT_PUBLIC_SITE_URL. Pengembangan: http://localhost:3000
# Beberapa domain: pisahkan dengan koma, mis. https://a.id,https://b.id
WEBAUTHN_ORIGIN=

# Database PostGIS lokasi (Simontini) — terpisah, hanya-baca. Kosongkan kolom-kolomnya untuk mematikan pencarian lokasi.
GEO_DATABASE_URL=
GEO_LOCATION_TABLE=
GEO_NAME_COLUMN=
GEO_LAT_COLUMN=
GEO_LNG_COLUMN=
GEO_SEARCH_COLUMNS=

# Cloudflare Turnstile. Kosong = verifikasi dilewati DI PENGEMBANGAN saja; di
# produksi (NODE_ENV=production) secret kosong berarti SEMUA kiriman ditolak
# (fail-closed), jadi wajib diisi sebelum rilis.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Jumlah reverse proxy tepercaya di depan aplikasi. Menentukan berapa dalam
# X-Forwarded-For boleh dipercaya untuk membaca IP asli pengunjung (dipakai
# Turnstile, pencatatan moderasi, dan batas laju per IP). 0 = tak ada proxy,
# header diabaikan (IP tak dicatat, tapi tak bisa dipalsukan). Di belakang
# satu proxy (nginx, Vercel, dsb.) setel 1.
# WAJIB di produksi: isi dengan jumlah proxy tepercaya di depan container.
# Tanpa IP, batas laju per IP jatuh ke SATU ember bersama untuk semua
# pengunjung (10× lebih longgar, lib/batas-laju.ts) dan server mencatat
# peringatan "ip-tak-terbaca" paling sering sejam sekali.
TRUSTED_PROXY_HOPS=0

# Data peta (/api/{hotspot,sebaran-asap,udara,cuaca-lokal,forecasting,citra/*})
# dilayani repo geoplatform — jalankan `npm run dev` di sana (:3100). Peramban
# memanggilnya langsung di NEXT_PUBLIC_GEO_URL (dipanggang saat build).
# Kosong = http://localhost:3100 di dev, https://geoplatform.nusantara.earth
# di build produksi. CAMS_ZARR_TOKEN, FIRMS_MAP_KEY, dan CRON_SECRET pindah ke
# .env geoplatform.
NEXT_PUBLIC_GEO_URL=

# Redis opsional untuk batas laju laporan & login (lib/batas-laju.ts). Kosong =
# penghitung di memori proses (benar untuk satu container saja).
REDIS_URL=redis://127.0.0.1:6379

# Alarm galat server (opsional): URL webhook Slack atau Discord. Galat simpan
# laporan/kejadian dan galat yang lolos ke Next dikirim ke sini, maks. sekali
# per 5 menit per jenis. Kosong = hanya log container.
ALERT_WEBHOOK_URL=
# ── Aplikasi mobile Lapor Karhutla (/api/mobile/*) ───────────────────────────
# OAuth client Google tipe "Web application" — SAMA dengan
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID di aplikasi (aud idToken). Kosong = masuk
# dengan Google dari aplikasi dijawab 503.
GOOGLE_WEB_CLIENT_ID=
# Bundle ID iOS aplikasi (aud token Sign in with Apple), boleh beberapa dipisah
# koma — build produksi dan varian preview (APP_VARIANT=preview). Kosong = 503.
APPLE_BUNDLE_ID=earth.nusantara.fire.lapor,earth.nusantara.fire.lapor.preview
# Kunci "Sign in with Apple" dari developer.apple.com (Keys, berkas .p8): untuk
# mencabut token Apple saat warga menghapus akun (App Store 5.1.1(v)). Kunci
# PEM boleh satu baris dengan \n. Kosong = token tidak disimpan/dicabut.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Kunci segel AES-256-GCM refresh_token Apple di basis data (string acak, mis.
# `openssl rand -base64 32`; gen-secrets.sh mengisinya otomatis). Kosong =
# token tidak disimpan. JANGAN diganti setelah terisi: token yang tersegel
# kunci lama tak bisa dibuka lagi, jadi tak bisa dicabut saat akun dihapus.
APPLE_TOKEN_SECRET=
# Siaran langsung (LiveKit Cloud: wss://<proyek>.livekit.cloud, atau self-host
# dengan TLS + UDP 50000–60000). Kosong = rute siaran dijawab 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Notifikasi push aplikasi (lib/notifikasi-push.ts) lewat Expo Push: tanpa nilai apa pun sudah jalan.
# Isi hanya bila "enhanced security for push notifications" dinyalakan di proyek Expo (access token
# dari expo.dev → Account settings → Access tokens). Kredensial FCM/APNs disimpan di EAS, bukan di sini.
EXPO_ACCESS_TOKEN=
# Verifikasi KTP — syarat siaran langsung publik (POST /api/mobile/saya/verifikasi,
# ditinjau petugas di /admin/verifikasi). Kunci HMAC-SHA256 untuk NIK: WAJIB di
# produksi, ≥ 32 karakter acak (`openssl rand -base64 32`; gen-secrets.sh
# mengisinya otomatis). Kosong/pendek di produksi = pengajuan dijawab 503.
# JANGAN diganti setelah terisi: sidik NIK lama tak bisa dibandingkan lagi, jadi
# satu NIK bisa dipakai lagi oleh akun lain.
KTP_NIK_SECRET=
# Folder foto KTP selama menunggu keputusan (dihapus begitu
# diputuskan). Tidak boleh di dalam public/, media/, atau .next/. Kosong =
# <folder kerja>/privat/ktp (container: /app/privat/ktp, volume ktp-privat di
# docker-compose.prod.yml — tanpa volume, foto yang menunggu hilang saat deploy).
KTP_DIR=
# Pemeriksaan otomatis pengajuan KTP (lib/ekyc.ts). `paddleocr` = layanan OCR
# internal (layanan/ocr-ktp, service ocr-ktp di docker-compose.prod.yml) membaca
# NIK di foto KTP dan membandingkannya dengan NIK ketikan. OCR hanya membaca —
# tidak memeriksa keaslian KTP atau Dukcapil. Kosong = semua pengajuan
# ditinjau petugas tanpa lencana OCR.
EKYC_PROVIDER=paddleocr
# Alamat layanan OCR. Produksi: http://ocr-ktp:8866 (sudah disetel compose).
# Lokal: http://127.0.0.1:8866 (lihat layanan/ocr-ktp/README.md).
OCR_URL=
# Kunci bersama situs ↔ layanan OCR (header X-Kunci-OCR), ≥ 16 karakter acak,
# mis. `openssl rand -hex 24`. Kosong = layanan OCR menolak semua permintaan
# (pengajuan tetap masuk antrean petugas).
OCR_KUNCI=
# bantu (bawaan) = hasil OCR hanya lencana untuk petugas, tidak memutuskan apa
# pun. otomatis = NIK di foto cocok dengan skor baca ≥ 0,9 → langsung disetujui
# (metode ekyc); selain itu tetap ke petugas. OCR tidak pernah menolak.
KTP_OCR_MODE=bantu
# 1 = POST /api/mobile/masuk/uji aktif (masuk aplikasi dengan nama saja, untuk menguji).
# Saat NODE_ENV=production juga wajib MOBILE_MASUK_UJI_KODE (≥ 16 karakter acak) yang
# sama dengan EXPO_PUBLIC_MASUK_UJI_KODE build preview aplikasi; tanpa itu tetap 404.
MOBILE_MASUK_UJI=
MOBILE_MASUK_UJI_KODE=
